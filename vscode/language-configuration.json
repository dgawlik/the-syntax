{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*\\$>\\s*(#.*)?$",
      "end": "^\\s*<\\$\\s*$"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(if|else|while|for|def|try|on_error)\\b.*:\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*(else|on_error)\\b.*:\\s*(#.*)?$"
  },
  "wordPattern": "(\\$[A-Za-z_]\\w*)|([A-Za-z_]\\w*)|(\\d+(\\.\\d+)?)"
}
