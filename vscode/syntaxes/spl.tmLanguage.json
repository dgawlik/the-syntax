{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SPL",
  "scopeName": "source.spl-language",
  "patterns": [
    { "include": "#marker" },
    { "include": "#multiline-block" },
    { "include": "#single-block" }
  ],
  "repository": {
    "embedded": {
      "comment": "Content of a ```spl fence in Markdown: blocks plus bare statements.",
      "patterns": [
        { "include": "#marker" },
        { "include": "#multiline-block" },
        { "include": "#single-block" },
        { "include": "#code" }
      ]
    },
    "marker": {
      "match": "(@\\{)(SPL)(/)(off|[^}\\s]*)(\\})",
      "name": "meta.directive.spl",
      "captures": {
        "1": { "name": "punctuation.definition.directive.begin.spl" },
        "2": { "name": "keyword.control.directive.spl" },
        "3": { "name": "punctuation.separator.spl" },
        "4": { "name": "constant.numeric.version.spl" },
        "5": { "name": "punctuation.definition.directive.end.spl" }
      }
    },
    "multiline-block": {
      "begin": "(\\$>)[ \\t]*(?=(?:#.*)?$)",
      "end": "<\\$|\\z",
      "beginCaptures": { "1": { "name": "punctuation.section.embedded.begin.spl" } },
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.spl" } },
      "name": "meta.block.multiline.spl",
      "patterns": [{ "include": "#code" }]
    },
    "single-block": {
      "begin": "(\\$>)(?=[ \\t]*\\S)",
      "end": "(?=^\\S)",
      "beginCaptures": { "1": { "name": "punctuation.section.embedded.begin.spl" } },
      "name": "meta.block.single.spl",
      "patterns": [{ "include": "#code" }]
    },
    "code": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#string-single" },
        { "include": "#string-double" },
        { "include": "#function-def" },
        { "include": "#keywords" },
        { "include": "#constants" },
        { "include": "#numbers" },
        { "include": "#variable" },
        { "include": "#builtin" },
        { "include": "#semantic-marker" },
        { "include": "#field-access" },
        { "include": "#operators" },
        { "include": "#braces" },
        { "include": "#tool-call" },
        { "include": "#function-call" },
        { "include": "#punctuation" }
      ]
    },
    "comment": {
      "match": "(#).*$",
      "name": "comment.line.number-sign.spl",
      "captures": { "1": { "name": "punctuation.definition.comment.spl" } }
    },
    "string-single": {
      "begin": "'",
      "end": "'|$",
      "name": "string.quoted.single.spl",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.spl" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.spl" } },
      "patterns": [{ "include": "#string-content" }]
    },
    "string-double": {
      "begin": "\"",
      "end": "\"|$",
      "name": "string.quoted.double.spl",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.spl" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.spl" } },
      "patterns": [{ "include": "#string-content" }]
    },
    "string-content": {
      "patterns": [
        {
          "match": "\\\\['\"\\\\$]",
          "name": "constant.character.escape.spl"
        },
        {
          "begin": "\\$\\{",
          "end": "\\}|$",
          "name": "meta.interpolation.spl",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.spl" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.spl" } },
          "contentName": "meta.embedded.expression.spl",
          "patterns": [
            {
              "match": "\\G[A-Za-z_]\\w*(?=\\})",
              "name": "variable.other.interpolated.spl"
            },
            { "include": "#code" }
          ]
        },
        {
          "match": "(\\$)([A-Za-z_]\\w*)",
          "name": "meta.interpolation.spl",
          "captures": {
            "1": { "name": "punctuation.definition.variable.spl" },
            "2": { "name": "variable.other.interpolated.spl" }
          }
        }
      ]
    },
    "function-def": {
      "match": "\\b(def)\\b(?:\\s+([A-Za-z_]\\w*))?",
      "captures": {
        "1": { "name": "storage.type.function.spl" },
        "2": { "name": "entity.name.function.spl" }
      }
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(?:let|reset)\\b",
          "name": "storage.type.spl"
        },
        {
          "match": "\\b(?:out|elicit|think|enforce|forbid|assert|fail)\\b",
          "name": "keyword.control.statement.spl"
        },
        {
          "match": "\\b(?:if|else|while|for|in|break|continue|return|yield|try|on_error)\\b",
          "name": "keyword.control.flow.spl"
        }
      ]
    },
    "constants": {
      "match": "\\b(?:true|false|null)\\b",
      "name": "constant.language.spl"
    },
    "numbers": {
      "match": "\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b",
      "name": "constant.numeric.spl"
    },
    "variable": {
      "match": "(\\$)([A-Za-z_]\\w*)",
      "name": "variable.other.spl",
      "captures": {
        "1": { "name": "punctuation.definition.variable.spl" }
      }
    },
    "builtin": {
      "match": "\\blen(?=\\s*\\()",
      "name": "support.function.builtin.spl"
    },
    "semantic-marker": {
      "match": "\\?(?=\\s*['\"])",
      "name": "keyword.operator.semantic.spl"
    },
    "field-access": {
      "match": "(\\.)(?!\\.)([A-Za-z_]\\w*)",
      "captures": {
        "1": { "name": "punctuation.accessor.spl" },
        "2": { "name": "variable.other.property.spl" }
      }
    },
    "operators": {
      "patterns": [
        { "match": "->", "name": "keyword.operator.arrow.spl" },
        { "match": "\\.\\.", "name": "keyword.operator.range.spl" },
        { "match": "==|!=|<=|>=|<|>", "name": "keyword.operator.comparison.spl" },
        { "match": "&|\\||!", "name": "keyword.operator.logical.spl" },
        { "match": "\\+|-|\\*|/", "name": "keyword.operator.arithmetic.spl" },
        { "match": "=", "name": "keyword.operator.assignment.spl" }
      ]
    },
    "braces": {
      "comment": "Tool/statement parameters {name=value} and JSON object literals.",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.section.braces.begin.spl" } },
      "endCaptures": { "0": { "name": "punctuation.section.braces.end.spl" } },
      "name": "meta.braces.spl",
      "patterns": [
        {
          "match": "\\b[A-Za-z_]\\w*(?=\\s*=(?!=))",
          "name": "variable.parameter.spl"
        },
        { "include": "#code" }
      ]
    },
    "tool-call": {
      "match": "\\b[A-Za-z_]\\w*(?=\\s*\\{)",
      "name": "support.function.tool.spl"
    },
    "function-call": {
      "match": "\\b[A-Za-z_]\\w*(?=\\s*\\()",
      "name": "entity.name.function.call.spl"
    },
    "punctuation": {
      "patterns": [
        { "match": ",", "name": "punctuation.separator.comma.spl" },
        { "match": ":", "name": "punctuation.separator.colon.spl" },
        { "match": "[\\[\\]()]", "name": "punctuation.section.brackets.spl" }
      ]
    }
  }
}
