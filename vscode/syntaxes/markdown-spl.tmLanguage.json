{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SPL Fenced Blocks in Markdown",
  "scopeName": "markdown.spl.fenced",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [
    {
      "name": "markup.fenced_code.block.markdown",
      "begin": "^\\s*(`{3,}|~{3,})\\s*(?:spl|semantic-prompt-language)\\s*$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.fenced.markdown"
        }
      },
      "end": "^\\s*(?:`{3,}|~{3,})\\s*$",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.fenced.markdown"
        }
      },
      "contentName": "meta.embedded.block.semantic-prompt-language",
      "patterns": [
        {
          "include": "source.semantic-prompt-language"
        }
      ]
    }
  ]
}
