{
  "name": "spl-language",
  "displayName": "SPL - Semantic Prompt Language",
  "description": "Syntax highlighting for Semantic Prompt Language (SPL) in .spl files and ```spl blocks in Markdown.",
  "version": "0.1.0",
  "publisher": "dgawlik",
  "repository": {
    "type": "git",
    "url": "https://github.com/dgawlik/the-syntax.git",
    "directory": "vscode"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "spl",
    "semantic prompt language",
    "prompt",
    "llm",
    "syntax"
  ],
  "contributes": {
    "languages": [
      {
        "id": "semantic-prompt-language",
        "aliases": [
          "SPL",
          "Semantic Prompt Language",
          "spl"
        ],
        "extensions": [
          ".spl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "semantic-prompt-language",
        "scopeName": "source.spl-language",
        "path": "./syntaxes/spl.tmLanguage.json"
      },
      {
        "scopeName": "markdown.spl.codeblock",
        "path": "./syntaxes/spl-markdown-injection.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.spl": "spl"
        }
      }
    ]
  },
  "scripts": {
    "test": "node test/run.js",
    "package": "vsce package --skip-license"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.0.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.0.0"
  }
}
