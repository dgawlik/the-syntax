{
  "name": "spl-chat",
  "displayName": "SPL Chat",
  "description": "A cell-based SPL/1.0 chat client powered by GitHub Copilot language models.",
  "version": "0.0.1",
  "publisher": "the-syntax",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Chat"
  ],
  "activationEvents": [
    "onCommand:splChat.open"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "splChat.open",
        "title": "SPL: Open Chat",
        "category": "SPL"
      }
    ],
    "languages": [
      {
        "id": "spl",
        "aliases": [
          "SPL",
          "Semantic Prompt Language"
        ],
        "extensions": [
          ".spl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "spl",
        "scopeName": "source.spl",
        "path": "./syntaxes/spl.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p ."
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.7.2"
  }
}
